---
import Layout from '../../layouts/Layout.astro';
import Seo from '../../shared/components/Seo.astro';
import PhotoUploader from '../../components/photos/PhotoUploader.astro';
import { DEFAULT_EVENT_ROUTE_SLUG } from '../../lib/events/demo-events';
import '../../features/invitation/styles/invitation.css';

const appUrl = (import.meta.env.PUBLIC_APP_URL || 'https://invitation-gender-reveal.vercel.app').replace(/\/$/, '');
const canonicalUrl = `${appUrl}/${DEFAULT_EVENT_ROUTE_SLUG}/upload`;
---

<Layout bodyClass="photo-upload-page">
  <Seo
    slot="head"
    title="Subir fotos | Gender Reveal de Catherine & Josafat"
    description="Comparte tus fotos del evento para mostrarlas en la pantalla en vivo."
    canonicalUrl={canonicalUrl}
    robots="noindex, nofollow"
  />

  <PhotoUploader routeSlug={DEFAULT_EVENT_ROUTE_SLUG} />
</Layout>
